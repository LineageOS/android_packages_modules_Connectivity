package {
    // See: http://go/android-license-faq
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_library {
    name: "framework-connectivity-module-lib-stubs-dexed-for-hiddenapi-list",
    static_libs: [
        "framework-tethering.stubs.module_lib",
        "framework-connectivity.stubs.module_lib",
        "framework-connectivity-t.stubs.module_lib",
        "framework-connectivity-b.stubs.module_lib",
    ],
    compile_dex: true,
    visibility: ["//visibility:private"],
}

// A generator for hidden API lists for connectivity: removes module API from the blocked list.
// Run on: out/soong/.intermediates/packages/modules/Connectivity/Tethering/apex/
//                 com.android.tethering-bootclasspath-fragment/android_common_apex30/
//                 modular-hiddenapi/all-flags.csv
// With: java -jar NetHiddenApiListGenerator.jar \
//     all-flags.csv \
//     framework-connectivity-module-lib-stubs-dexed-for-hiddenapi-list.jar \
//     outfile.csv
java_binary_host {
    name: "NetHiddenApiListGenerator",
    srcs: ["src/**/*.kt"],
    main_class: "com.android.connectivity.hiddenapi.HiddenNetApiList",
    static_libs: [
        "kotlin-test",
    ],
}
