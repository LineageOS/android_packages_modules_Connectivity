package {
    default_team: "trendy_team_enigma",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_test {
    name: "CtsVcnTestCases",
    defaults: [
        "cts_defaults",
        "framework-connectivity-test-defaults",
    ],

    min_sdk_version: "36",

    // Include both the 32 and 64 bit versions
    compile_multilib: "both",

    libs: [
        "android.test.base.stubs.system",
    ],

    srcs: [
        "src/**/*.java",
    ],

    static_libs: [
        "androidx.test.ext.junit",
        "compatibility-device-util-axt",
        "cts-net-utils",
        "ctstestrunner-axt",
        "ike-tun-utils",
        "net-tests-utils",
        "telephony-cts-utils",
        "android.net.vcn.flags-aconfig-java-export",
        "flag-junit",
    ],

    platform_apis: true,

    // Tag this module as a cts test artifact
    // TODO: b/375213246 Add "mcts-tethering" when VCN libs are
    // built into Tethering module
    // TODO: b/379938062 Move CtsVcnTestCases to the Tethering
    // module folder (packages/modules/Connectivity)
    test_suites: [
        "cts",
        "general-tests",
        "mts-tethering",
        "mcts-tethering",
    ],
    data: [":ConnectivityTestPreparer"],
    host_required: ["net-tests-utils-host-common"],
    host_common_data: [":net-tests-utils-host-common"],
}
